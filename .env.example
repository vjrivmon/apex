# ============================================
# APEX — Environment Configuration
# ============================================

# Mode: "development" (Claude Code as brain) or "production" (local LLMs)
APEX_MODE=production

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8020

# Frontend
FRONTEND_PORT=3020
NEXT_PUBLIC_API_URL=http://localhost:8020
NEXT_PUBLIC_WS_URL=ws://localhost:8020

# LLM — Ollama (Slimbook local via Tailscale)
OLLAMA_BASE_URL=http://100.88.164.20:11434
OLLAMA_CONVERSATION_MODEL=gemma4:e4b
OLLAMA_ARCHITECT_MODEL=deepseek-r1:14b
OLLAMA_RAG_MODEL=gemma4:e2b
OLLAMA_CODEGEN_MODEL=qwen3.5:9b

# LLM — VRAIN UPV (fallback for large models)
VRAIN_BASE_URL=https://ollama.gti-ia.upv.es
VRAIN_CODEGEN_MODEL=qwen3:32b

# RAG — ChromaDB
CHROMA_HOST=100.88.164.20
CHROMA_PORT=8000

# Database
DATABASE_URL=sqlite:///./apex.db

# Logging
LOG_LEVEL=INFO
